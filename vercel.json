{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-deployment-ignore.mjs",
  "buildCommand": "node scripts/verify-deployment-environment.mjs && npm run build",
  "crons": [
    {
      "path": "/api/cron/profile-completion-reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/meta-social-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/tiktok-social-sync",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/sync-google-community-events",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/internship-assignment-reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/growth-reports",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/social-intelligence-sync",
      "schedule": "20 * * * *"
    }
  ]
}

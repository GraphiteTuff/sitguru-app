{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-deployment-ignore.mjs",
  "buildCommand": "node scripts/verify-deployment-environment.mjs && npm run build",
  "crons": [
    {
      "path": "/api/cron/profile-completion-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/social-metrics-baseline",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sync-google-community-events",
      "schedule": "30 6 * * *"
    }
  ]
}

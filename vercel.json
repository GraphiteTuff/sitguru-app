{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash -c '[[ \"$VERCEL_GIT_COMMIT_REF\" != \"sitguru-main\" && \"$VERCEL_GIT_COMMIT_REF\" != \"feature/admin-intern-assignment-preview-20261113\" ]]'",
  "crons": [
    {
      "path": "/api/cron/profile-completion-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/social-metrics-baseline",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sync-google-community-events",
      "schedule": "30 6 * * *"
    }
  ],
  "buildCommand": "npx tsx --test lib/internship/admin-preview.test.ts && npm run build"
}

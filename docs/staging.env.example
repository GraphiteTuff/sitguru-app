# Copy into the staging host's secret store and the local shell that runs
# scripts/test-ambassador-referral.ts. Do not commit filled-in values.
# Production project mmtjhxnzuglbyumbsjhs and sk_live keys are rejected.

# --- Staging application (the eight deployment variables) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://staging.sitguru.com
NEXT_PUBLIC_SITE_URL=https://staging.sitguru.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. If empty, referral seals use the staging service role.
REFERRAL_CAPTURE_SECRET=

# --- QA harness only. Not required on the public web server. ---
SITGURU_QA_ENV=staging
SITGURU_QA_BASE_URL=https://staging.sitguru.com
SITGURU_QA_GURU_ID=
SITGURU_QA_EMAIL_DOMAIN=example.com

# --- Expo staging build. Public values only. No service role. ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SITGURU_API_URL=https://staging.sitguru.com
EXPO_PUBLIC_SITGURU_APP_CHANNEL=staging
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

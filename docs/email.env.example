# SitGuru email environment variables (names only — no secrets)

Copy into Vercel / server env as needed. Never put these in Expo / client bundles.

## Required for application email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SitGuru <support@sitguru.com>
RESEND_REPLY_TO_EMAIL=support@sitguru.com

## Optional From / Reply-To overrides
SITGURU_FROM_EMAIL=
SITGURU_SUPPORT_FROM=SitGuru Support <support@sitguru.com>
SITGURU_SUPPORT_EMAIL=support@sitguru.com
SITGURU_ALERT_FROM_EMAIL=SitGuru <alerts@sitguru.com>
ALERT_FROM_EMAIL=
SUPPORT_FROM_EMAIL=
SUPPORT_TO_EMAIL=
FINANCE_ALERT_FROM_EMAIL=
FINANCIAL_EXPORT_FROM_EMAIL=

## Admin / alert recipients (comma-separated)
ADMIN_ALERT_EMAILS=
SITGURU_ADMIN_ALERT_EMAILS=
SIGNUP_ALERT_EMAILS=
MARKETING_LEAD_ALERT_EMAILS=
SITGURU_BROADCAST_EMAILS=

## Public HTTPS origins used in email links
NEXT_PUBLIC_SITE_URL=https://www.sitguru.com
NEXT_PUBLIC_APP_URL=https://www.sitguru.com
SITE_URL=https://www.sitguru.com

## Optional branding
SITGURU_EMAIL_LOGO_URL=

## Resend delivery webhooks (server only — never Expo / NEXT_PUBLIC_)
RESEND_WEBHOOK_SECRET=

## Status check only (not an active sender in this repo)
SENDGRID_API_KEY=

# Auth email SMTP is configured in the Supabase Dashboard, not via these names.

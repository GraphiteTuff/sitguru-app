{
  "expo": {
    "name": "SitGuru",
    "slug": "sitguru-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sitgurumobile",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#0D5C3A",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.sitguru.mobile",
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "SitGuru",
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": [
          "en",
          "en"
        ],
        "LSRequiresIPhoneOS": true,
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification",
          "location",
          "fetch",
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "SitGuru uses your location during active booked visits so Pet Parents can follow live care routes on PawReport Live.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SitGuru shares live care routes with Pet Parents during active booked visits, including when the app is in the background.",
        "NSLocationAlwaysUsageDescription": "SitGuru continues sharing your care route in the background only while a booked visit is active.",
        "NSCameraUsageDescription": "SitGuru uses the camera for care photos, vaccine scans, and Pet Passport documents.",
        "NSPhotoLibraryUsageDescription": "SitGuru needs photo access to attach images in chat, PawReports, and Pet Passports.",
        "NSPhotoLibraryAddUsageDescription": "SitGuru can save care photos to your library when you choose to download them.",
        "NSMicrophoneUsageDescription": "SitGuru uses the microphone to record voice notes for Pet Parents and Gurus.",
        "NSFaceIDUsageDescription": "Allow SitGuru to use Face ID for faster, secure access to your account.",
        "NSUserTrackingUsageDescription": "SitGuru does not track you across other companies’ apps or websites for advertising.",
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.sitguru.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0D5C3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "sitgurumobile"
            },
            {
              "scheme": "https",
              "host": "sitguru.com",
              "pathPrefix": "/mobile"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "sitgurumobile"
            },
            {
              "scheme": "https",
              "host": "sitguru.com",
              "pathPrefix": "/mobile"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "SitGuru",
      "shortName": "SitGuru",
      "themeColor": "#0D5C3A",
      "backgroundColor": "#0D5C3A",
      "splash": {
        "image": "./assets/images/splash-icon-sitguru.png",
        "resizeMode": "contain",
        "backgroundColor": "#0D5C3A"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D5C3A",
          "image": "./assets/images/splash-icon-sitguru.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#102417",
            "image": "./assets/images/splash-icon-sitguru.png"
          },
          "android": {
            "image": "./assets/images/splash-icon-sitguru.png",
            "imageWidth": 160,
            "backgroundColor": "#0D5C3A"
          },
          "ios": {
            "image": "./assets/images/splash-icon-sitguru.png",
            "imageWidth": 200,
            "backgroundColor": "#0D5C3A"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SitGuru to use Face ID for faster, secure access to your account."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.sitguru",
          "enableGooglePay": true
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SitGuru to record voice notes for Pet Parents and Gurus during care handoffs."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SitGuru to share live care routes with Pet Parents during active booked visits, including when the app is in the background.",
          "locationAlwaysPermission": "Allow SitGuru to continue sharing your care route in the background during an active visit.",
          "locationWhenInUsePermission": "Allow SitGuru to track live care routes only during active booked visits.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SitGuru to attach photos in chat, PawReports, and Pet Passports.",
          "cameraPermission": "Allow SitGuru to take care photos and scan vaccine papers.",
          "microphonePermission": "Allow SitGuru to record voice notes for Pet Parents and Gurus."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SitGuru to scan vaccine papers for Pet Passports and capture care photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0D5C3A",
          "defaultChannel": "sitguru-bookings",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "sitguru": {
        "brandColor": "#0D5C3A",
        "supportUrl": "https://sitguru.com/support",
        "privacyUrl": "https://sitguru.com/privacy",
        "termsUrl": "https://sitguru.com/terms"
      },
      "eas": {
        "projectId": "9048d147-3f05-46a3-b442-c05be543417d"
      }
    },
    "owner": "sitguru",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9048d147-3f05-46a3-b442-c05be543417d"
    }
  }
}

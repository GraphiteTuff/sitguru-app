# SitGuru mobile Supabase public client configuration.
# Use publishable key or anon public key only for client-side mobile.
# Do not put service role keys in the mobile app.
# Do not commit .env.local.
# RLS must protect production data later.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy fallback only if needed:
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Same SitGuru web origin used by desktop for privileged mutations
# (bookings create, messages send, walk actions, mobile checkout).
# Example: https://sitguru.com  or  http://localhost:3000
EXPO_PUBLIC_SITGURU_API_URL=
# Optional aliases also accepted by the data layer:
# EXPO_PUBLIC_SITGURU_WEB_URL=
# EXPO_PUBLIC_APP_URL=
# EXPO_PUBLIC_SITE_URL=

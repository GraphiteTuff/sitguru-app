/**
 * Live Supabase production schema reflection for Rogue (project mmtjhxnzuglbyumbsjhs).
 *
 * SitGuru does NOT run Prisma migrations against production — schema is owned by
 * supabase/migrations. This file is the local binding surface for Rogue tooling.
 *
 * Regenerated 2026-08-02 via live PostgREST column probes (prisma db pull blocked:
 * DATABASE_URL / Postgres password not available in this cloud agent environment).
 * When DATABASE_URL is set, prefer: `npx prisma db pull --force`
 *
 * Compatibility / accessory tables (payments, payouts, live_walks, moderation_flags,
 * fraud_flags, financial_audit_logs) may be missing from live PostgREST until
 * supabase/migrations/20260802_structural_schema_alignment_rogue.sql is applied.
 * Rogue admin-reporting falls back to production aliases in those cases.
 *
 * Column aliases that commonly miss the PostgREST schema cache:
 *   admin_marketing_campaigns.title        → name
 *   admin_marketing_signup_leads.status    → lead_status
 *   referral_codes.program                 → program_type / program_context
 */

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Canonical payment ledger (cents). There is no public.payments table in prod.
model BookingPayment {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId             String?   @map("booking_id")
  status                String?
  amountCents           BigInt?   @map("amount_cents")
  provider              String?
  currency              String?
  stripePaymentIntentId String?   @map("stripe_payment_intent_id")
  stripeChargeId        String?   @map("stripe_charge_id")
  receiptUrl            String?   @map("receipt_url")
  paidAt                DateTime? @map("paid_at") @db.Timestamptz(6)
  failedAt              DateTime? @map("failed_at") @db.Timestamptz(6)
  metadata              Json?
  createdAt             DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("booking_payments")
}

/// Guru payouts — amounts live as net_amount / gross_amount (not amount / amount_cents).
model GuruPayout {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guruId           String?  @map("guru_id") @db.Uuid
  bookingId        String?  @map("booking_id")
  payoutStatus     String?  @map("payout_status")
  stripeTransferId String?  @map("stripe_transfer_id")
  netAmount        Decimal? @map("net_amount") @db.Decimal
  grossAmount      Decimal? @map("gross_amount") @db.Decimal
  createdAt        DateTime? @map("created_at") @db.Timestamptz(6)

  @@map("guru_payouts")
}

model AdminAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorEmail String?  @map("actor_email")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime? @map("created_at") @db.Timestamptz(6)

  @@map("admin_audit_logs")
}

/// Finance/CPA audit trail. Falls back to admin_audit_logs when unmapped in PostgREST.
model FinancialAuditLog {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?   @map("actor_id") @db.Uuid
  actorEmail String?   @map("actor_email")
  actorRole  String?   @map("actor_role")
  action     String
  area       String?
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  entityType String?   @map("entity_type")
  severity   String?
  metadata   Json?
  createdAt  DateTime? @map("created_at") @db.Timestamptz(6)

  @@map("financial_audit_logs")
}

/// Trust & safety moderation queue. Live alias: support_intake_cases.
model ModerationFlag {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status      String?   @default("open")
  subjectType String?   @map("subject_type")
  subjectId   String?   @map("subject_id")
  reason      String?
  severity    String?
  metadata    Json?
  createdAt   DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("moderation_flags")
}

/// Trust & safety fraud queue. Live alias: dispute_cases.
model FraudFlag {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status      String?   @default("open")
  subjectType String?   @map("subject_type")
  subjectId   String?   @map("subject_id")
  reason      String?
  severity    String?
  metadata    Json?
  createdAt   DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("fraud_flags")
}

model Booking {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status       String?
  totalAmount  Decimal?  @map("total_amount") @db.Decimal
  petParentId  String?   @map("pet_parent_id") @db.Uuid
  guruId       String?   @map("guru_id") @db.Uuid
  serviceType  String?   @map("service_type")
  createdAt    DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("bookings")
}

/// Live walk tracks (no public.live_walks / walk_sessions in prod).
model BookingWalkTrack {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String?   @map("booking_id")
  guruId    String?   @map("guru_id") @db.Uuid
  status    String?
  startedAt DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("booking_walk_tracks")
}

/// GPS points for walk tracks (no public.gps_events in prod).
model BookingWalkTrackPoint {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walkTrackId String?   @map("walk_track_id") @db.Uuid
  bookingId   String?   @map("booking_id")
  lat         Float?
  lng         Float?
  accuracy    Float?
  recordedAt  DateTime? @map("recorded_at") @db.Timestamptz(6)
  createdAt   DateTime? @map("created_at") @db.Timestamptz(6)

  @@map("booking_walk_track_points")
}

/// Sales & marketing campaigns. Live rows expose `name`; Rogue also binds `title`.
model AdminMarketingCampaign {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?
  title          String?
  status         String?
  audience       String?
  goal           String?
  primaryCta     String?   @map("primary_cta")
  landingPage    String?   @map("landing_page")
  contentNeeded  String?   @map("content_needed")
  outreachTieIn  String?   @map("outreach_tie_in")
  proofNeeded    String?   @map("proof_needed")
  ceoDecision    String?   @map("ceo_decision")
  successSignal  String?   @map("success_signal")
  ownerName      String?   @map("owner_name")
  createdAt      DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("admin_marketing_campaigns")
}

/// Marketing signup leads. Live status column is often `lead_status`.
model AdminMarketingSignupLead {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status           String?
  leadStatus       String?   @map("lead_status")
  leadType         String?   @map("lead_type")
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  fullName         String?   @map("full_name")
  email            String?
  phone            String?
  priorityLevel    String?   @map("priority_level")
  campaignSource   String?   @map("campaign_source")
  ownerName        String?   @map("owner_name")
  createdAt        DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("admin_marketing_signup_leads")
}

/// Referral inventory codes. Live program column is often `program_type`.
model ReferralCode {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String?
  status        String?
  program       String?
  programType   String?   @map("program_type")
  programContext String?  @map("program_context")
  ownerName     String?   @map("owner_name")
  userId        String?   @map("user_id") @db.Uuid
  ambassadorId  String?   @map("ambassador_id") @db.Uuid
  createdAt     DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("referral_codes")
}

/// Product analytics stream used by conversion-funnel diagnostics.
model AnalyticsEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  sessionId String?   @map("session_id")
  eventName String?   @map("event_name")
  eventType String?   @map("event_type")
  role      String?
  source    String?
  pagePath  String?   @map("page_path")
  guruId    String?   @map("guru_id")
  bookingId String?   @map("booking_id")
  metadata  Json?
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)

  @@map("analytics_events")
}

/// Omnichannel chat insight ledger (friction flags + help conversion).
model GlobalChatInsight {
  insightId            String    @id @default(dbgenerated("gen_random_uuid()")) @map("insight_id") @db.Uuid
  textStringHash       String?   @map("text_string_hash")
  coreQuestionSummary  String    @map("core_question_summary")
  aiAssignedCategory   String?   @map("ai_assigned_category")
  channelSourceEnum    String?   @map("channel_source_enum")
  frequencyTallyCount  Int?      @map("frequency_tally_count") @default(1)
  isConvertedToArticle Boolean?  @map("is_converted_to_article") @default(false)
  isFrictionFlag       Boolean?  @map("is_friction_flag") @default(false)
  convertedArticleSlug String?   @map("converted_article_slug")
  convertedAt          DateTime? @map("converted_at") @db.Timestamptz(6)
  createdAt            DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("global_chat_insights")
}
